{
  "name": "dsh-ladybug-yoyo-pomodoro",
  "version": "1.3.6",
  "description": "瓢虫少女悠悠球番茄钟 · Ladybug Yoyo Pomodoro — a fan-made round yoyo focus timer with an original completion chime for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "author": "JacobYixi",
  "repository": {
    "type": "git",
    "url": "https://github.com/JacobYixi/ladybug-yoyo-pomodoro.git"
  },
  "homepage": "https://github.com/JacobYixi/ladybug-yoyo-pomodoro",
  "bugs": {
    "url": "https://github.com/JacobYixi/ladybug-yoyo-pomodoro/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "pomodoro",
    "focus-timer",
    "ladybug"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
